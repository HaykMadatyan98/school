DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/school?retryWrites=true&w=majority"
JWT_SECRET="school-dev-secret-change-me"
JWT_EXPIRES_IN="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Google Drive — folder ID from Drive URL
GOOGLE_DRIVE_FOLDER_ID=1aa5dWvoAA3UjJPX0I-CY9bzrfH9rqNQS

# Preferred for personal Google accounts (has storage quota):
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# Then: cd apps/api && npx tsx scripts/google-drive-oauth.ts

# Service account (only works reliably with Shared Drives / Workspace):
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/google-service-account.json

# After creating OAuth Web client, add this Authorized redirect URI:
#   http://localhost:3001/api/uploads/google/callback
# Then open (while logged in as admin JWT is NOT needed for callback, but connect needs admin):
#   http://localhost:3001/api/uploads/google/connect
# Or with token: open Swagger /docs → Authorize → GET /uploads/google/connect
