{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    // Nest --watch deletes dist (deleteOutDir) then recompiles; with incremental
    // TS thinks emit is up to date and writes nothing → "Cannot find module dist/main".
    "incremental": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
